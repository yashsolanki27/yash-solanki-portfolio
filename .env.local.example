# Copy this file to .env.local and fill in your real key.
# Get a free access key at https://web3forms.com — no signup needed, just an email.
# This key is safe to expose client-side; Web3Forms is designed for that.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Canonical production URL (no trailing slash). Used for metadata, JSON-LD and sitemap.
NEXT_PUBLIC_SITE_URL=https://yash-portfolio-silk.vercel.app
